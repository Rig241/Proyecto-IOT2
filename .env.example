# El asistente scripts/configurar.py crea .env con permisos 600.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_PORT=1883
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
STALE_SECONDS=10
# Base64 evita problemas con $, comillas y espacios en Compose.
# Es reversible: proteger .env como una contraseña, no subirlo a Git.
MQTT_PASSWORD_B64=
